# Variables d'environnement du backend. À copier en /etc/pyquest/env (droits 640, propriétaire root:pyquest).
# JAMAIS commité avec de vraies valeurs. scripts/vps_bootstrap.sh génère PYQUEST_SECRET_KEY automatiquement.
DJANGO_SETTINGS_MODULE=pyquest_api.settings.production

# Chaîne aléatoire longue et secrète (générée à l'installation).
PYQUEST_SECRET_KEY=__A_GENERER__
# Domaine public (sans schéma) et origine complète.
PYQUEST_ALLOWED_HOSTS=pyquest.example.org
PYQUEST_ORIGIN=https://pyquest.example.org

# MariaDB (existante) : voir deploy/mariadb-setup.sql.example pour créer la base et l'utilisateur.
PYQUEST_DB_NAME=pyquest
PYQUEST_DB_USER=pyquest
PYQUEST_DB_PASSWORD=__A_REMPLIR__
PYQUEST_DB_HOST=127.0.0.1
PYQUEST_DB_PORT=3306

# Fichiers statiques de l'administration (servis par nginx sous /api/static/).
PYQUEST_STATIC_ROOT=/var/www/pyquest/static
