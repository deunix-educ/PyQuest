# Vhost PyQuest complet : application statique + backend Django (synchronisation et accès à l'éditeur de niveaux).
# À adapter : domaine, chemins, certificat. Sans backend, utiliser pyquest-static.conf.example.
# Contenu servi : le dossier « current » créé par scripts/deploy.sh. Django (gunicorn) écoute sur 127.0.0.1:8001.
# Les en-têtes COOP/COEP/CORP sont indispensables à l'interruption des boucles infinies et à input()
# (SharedArrayBuffer). Tout est servi depuis ce domaine, y compris Pyodide (COEP interdit les CDN).
#
# Éditeur de niveaux (author.html) : réservé aux comptes créés avec « manage.py create_author ». nginx demande à
# Django (auth_request → /api/auth/check/) si la session est valide ; sinon il redirige vers la page de connexion
# /api/auth/login/. Ce n'est pas indispensable à la sécurité des données (l'éditeur ne peut rien écrire sur le
# serveur) : cela évite seulement de l'exposer au public.
#
# Installation type : voir docs/site/fr/host/deploy.md. Vérifier avec « sudo nginx -t » avant de recharger.
# Fichiers à copier dans /etc/nginx/snippets/ : pyquest-locations.conf (depuis pyquest-locations.conf.example) et
# pyquest-author-headers.conf (depuis pyquest-author-headers.conf.example).

# Limites de débit (contexte http, hors bloc server) : synchronisation 30 req/min, connexion 6 req/min par IP.
limit_req_zone $binary_remote_addr zone=pyquest_sync:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=pyquest_login:10m rate=6r/m;

server {
    listen 80;
    listen [::]:80;
    server_name pyquest.example.org;

    # Défi HTTP de Let's Encrypt, puis tout le reste passe en HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;   # nginx >= 1.25.1 ; avant : « listen 443 ssl http2; » ci-dessus
    server_name pyquest.example.org;

    ssl_certificate     /etc/letsencrypt/live/pyquest.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pyquest.example.org/privkey.pem;

    # Dossier créé par scripts/deploy.sh (lien « current » basculé à chaque déploiement).
    root /var/www/pyquest/current;
    index index.html;

    # Types MIME, compression, en-têtes, éditeur protégé par Django et API : voir ce fichier (copié dans
    # /etc/nginx/snippets/pyquest-locations.conf). Il est aussi utilisé par l'essai local (make dev-nginx).
    include snippets/pyquest-locations.conf;
}
