# Modèle de docker/.env.vps (créé par ./docker/setup.sh vps, qui génère les secrets). JAMAIS commité avec de vraies valeurs.
PYQUEST_DOMAIN=pyquest.example.org
PYQUEST_EMAIL=toi@example.org
PYQUEST_SECRET_KEY=__A_GENERER__
PYQUEST_DB_PASSWORD=__A_GENERER__
# Ports publiés sur l'hôte (essais ; en production laisser 80 et 443). Si HTTPS n'est pas sur 443, ajouter
# PYQUEST_ORIGIN_PORT=:8443
PYQUEST_HTTP_PORT=80
PYQUEST_HTTPS_PORT=443
# Dossier des sauvegardes quotidiennes de la base (sur l'hôte).
PYQUEST_BACKUP_DIR=./backups
