# Variables d'environnement du backend, installation INTRANET (base SQLite, certificat de l'autorité interne).
# Copié en /etc/pyquest/env (640 root:pyquest) par deploy/install_intranet.sh, qui remplace les valeurs __…__.
# JAMAIS commité avec de vraies valeurs.
DJANGO_SETTINGS_MODULE=pyquest_api.settings.production

PYQUEST_SECRET_KEY=__A_GENERER__
# Noms et adresses IP par lesquels les postes joignent le serveur (séparés par des virgules).
PYQUEST_ALLOWED_HOSTS=__HOSTS__
PYQUEST_ORIGIN=__ORIGINS__

# Base SQLite : un simple fichier, sauvegardé par scripts/backup_db.sh.
PYQUEST_DB_ENGINE=sqlite
PYQUEST_DB_PATH=/var/lib/pyquest/db.sqlite3

PYQUEST_PORT=8001
PYQUEST_STATIC_ROOT=/var/www/pyquest/static

# Certificat de l'autorité interne : les contrôles (check_deploy, doctor) s'y fient ; le renouvellement est mensuel.
PYQUEST_TLS=internal
PYQUEST_TLS_DIR=/etc/pyquest/tls
