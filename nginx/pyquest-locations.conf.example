# Parties communes du vhost PyQuest : types MIME, compression, en-têtes d'isolation, éditeur protégé, API Django.
# Incluses par le bloc « server » de pyquest.conf.example (production) ET par scripts/local_stack.py (essai local avec
# un vrai nginx) : on teste ainsi exactement ce qui sera déployé. Le chemin d'include est relatif au dossier de
# configuration de nginx (/etc/nginx en production).
#
# Installation : copier ce fichier en /etc/nginx/snippets/pyquest-locations.conf et pyquest-author-headers.conf.example
# en /etc/nginx/snippets/pyquest-author-headers.conf. Les zones de limitation (limit_req_zone) sont dans le bloc http.
# Host $http_host (et non $host) : conserve le port, que Django compare à l'en-tête Origin des formulaires.

    # Types MIME explicites : un bloc « types » dans server remplace la table par défaut, donc on
    # liste tout ce que l'application sert. Les scripts-modules exigent text/javascript.
    types {
        text/html                  html;
        text/css                   css;
        text/javascript            js mjs;
        application/json           json;
        application/manifest+json  webmanifest;
        application/wasm           wasm;
        image/svg+xml              svg;
        image/png                  png;
        image/x-icon               ico;
        audio/mpeg                 mp3;
        font/woff2                 woff2;
        text/plain                 txt py yaml;
    }
    default_type application/octet-stream;

    # Compression : le moteur Python (wasm) et les scripts gagnent beaucoup.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/json application/wasm image/svg+xml text/plain application/manifest+json;

    # add_header n'est hérité que si le bloc location n'en déclare aucun : chaque location qui ajoute
    # un en-tête (cache) doit donc répéter ceux d'isolation. On les regroupe dans ce fichier-ci.
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        try_files $uri $uri/ =404;
        # Pages et scripts : revalidés à chaque chargement (le service worker passe par le réseau d'abord).
        add_header Cache-Control "no-cache" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    # Pyodide est versionné et immuable : cache long.
    location /vendor/pyodide/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    # ---- Éditeur de niveaux : protégé par la session Django -------------------------------------------------

    # Sous-requête interne : Django répond 204 (auteur connecté) ou 401. Le corps de la requête n'est pas transmis.
    location = /_auth_check {
        internal;
        proxy_pass http://127.0.0.1:8001/api/auth/check/;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Non connecté : page de connexion, qui ramène ensuite sur l'éditeur.
    location @author_login {
        return 302 /api/auth/login/?next=$request_uri;
    }

    # L'entrée et tout ce qui est propre à l'éditeur (le reste du code est commun avec l'application).
    location = /author.html {
        auth_request /_auth_check;
        error_page 401 = @author_login;
        include snippets/pyquest-author-headers.conf;
    }
    location = /css/author.css {
        auth_request /_auth_check;
        error_page 401 = @author_login;
        include snippets/pyquest-author-headers.conf;
    }
    location ^~ /js/author/ {
        auth_request /_auth_check;
        error_page 401 = @author_login;
        include snippets/pyquest-author-headers.conf;
    }
    location ~ ^/js/i18n/author\.[a-z]+\.json$ {
        auth_request /_auth_check;
        error_page 401 = @author_login;
        include snippets/pyquest-author-headers.conf;
    }

    # ---- Backend Django ------------------------------------------------------------------------------------

    # Connexion : peu d'essais autorisés (Django bloque aussi après 5 échecs par compte pendant 15 minutes).
    location = /api/auth/login/ {
        limit_req zone=pyquest_login burst=5 nodelay;
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;   # écrase toute valeur envoyée par le client
    }

    # Le reste de l'API (synchronisation, déconnexion) ; /api/auth/check/ n'est joignable que par la sous-requête interne.
    location = /api/auth/check/ {
        return 404;
    }
    location /api/ {
        limit_req zone=pyquest_sync burst=20 nodelay;
        client_max_body_size 300k;
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
