# Modèle de docker/.env.intranet (créé par ./docker/setup.sh intranet, qui génère le secret). JAMAIS commité avec de vraies valeurs.
# Noms et adresses IP par lesquels les postes joignent le serveur (séparés par des virgules, sans espace).
PYQUEST_HOSTS=pyquest.lycee.local,192.168.1.20
PYQUEST_ORIGINS=https://pyquest.lycee.local,https://192.168.1.20
PYQUEST_SECRET_KEY=__A_GENERER__
# Ports publiés sur l'hôte (essais ; en production laisser 80 et 443). Si HTTPS n'est pas sur 443, mettre le port dans
# PYQUEST_ORIGINS (https://hôte:8443).
PYQUEST_HTTP_PORT=80
PYQUEST_HTTPS_PORT=443
PYQUEST_BACKUP_DIR=./backups
