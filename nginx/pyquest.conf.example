# Vhost PyQuest complet : application statique + backend Django (synchronisation et accès à l'éditeur de niveaux).
# À adapter : domaine, chemins, certificat. Sans backend, utiliser pyquest-static.conf.example.
# Contenu servi : le dossier « current » créé par scripts/deploy.sh. Django (gunicorn) écoute sur 127.0.0.1:8001.
# Les en-têtes COOP/COEP/CORP sont indispensables à l'interruption des boucles infinies et à input()
# (SharedArrayBuffer). Tout est servi depuis ce domaine, y compris Pyodide (COEP interdit les CDN).
#
# Éditeur de niveaux (author.html) : réservé aux comptes créés avec « manage.py create_author ». nginx demande à
# Django (auth_request → /api/auth/check/) si la session est valide ; sinon il redirige vers la page de connexion
# /api/auth/login/. Ce n'est pas indispensable à la sécurité des données (l'éditeur ne peut rien écrire sur le
# serveur) : cela évite seulement de l'exposer au public.
#
# Installation type : voir docs/site/fr/host/deploy.md. Vérifier avec « sudo nginx -t » avant de recharger.

# Limites de débit (contexte http, hors bloc server) : synchronisation 30 req/min, connexion 6 req/min par IP.
limit_req_zone $binary_remote_addr zone=pyquest_sync:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=pyquest_login:10m rate=6r/m;

server {
    listen 80;
    listen [::]:80;
    server_name pyquest.example.org;

    # Défi HTTP de Let's Encrypt, puis tout le reste passe en HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;   # nginx >= 1.25.1 ; avant : « listen 443 ssl http2; » ci-dessus
    server_name pyquest.example.org;

    ssl_certificate     /etc/letsencrypt/live/pyquest.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pyquest.example.org/privkey.pem;

    # Dossier créé par scripts/deploy.sh (lien « current » basculé à chaque déploiement).
    root /var/www/pyquest/current;
    index index.html;

    # Types MIME explicites : un bloc « types » dans server remplace la table par défaut, donc on
    # liste tout ce que l'application sert. Les scripts-modules exigent text/javascript.
    types {
        text/html                  html;
        text/css                   css;
        text/javascript            js mjs;
        application/json           json;
        application/manifest+json  webmanifest;
        application/wasm           wasm;
        image/svg+xml              svg;
        image/png                  png;
        image/x-icon               ico;
        audio/mpeg                 mp3;
        font/woff2                 woff2;
        text/plain                 txt py yaml;
    }
    default_type application/octet-stream;

    # Compression : le moteur Python (wasm) et les scripts gagnent beaucoup.
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/json application/wasm image/svg+xml text/plain application/manifest+json;

    # add_header n'est hérité que si le bloc location n'en déclare aucun : chaque location qui ajoute
    # un en-tête (cache) doit donc répéter ceux d'isolation. On les regroupe dans ce fichier-ci.
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        try_files $uri $uri/ =404;
        # Pages et scripts : revalidés à chaque chargement (le service worker passe par le réseau d'abord).
        add_header Cache-Control "no-cache" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    # Pyodide est versionné et immuable : cache long.
    location /vendor/pyodide/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    # ---- Éditeur de niveaux : protégé par la session Django -------------------------------------------------

    # Sous-requête interne : Django répond 204 (auteur connecté) ou 401. Le corps de la requête n'est pas transmis.
    location = /_auth_check {
        internal;
        proxy_pass http://127.0.0.1:8001/api/auth/check/;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Non connecté : page de connexion, qui ramène ensuite sur l'éditeur.
    location @author_login {
        return 302 /api/auth/login/?next=$request_uri;
    }

    # L'entrée et tout ce qui est propre à l'éditeur (le reste du code est commun avec l'application).
    location = /author.html {
        auth_request /_auth_check;
        error_page 401 = @author_login;
        include /etc/nginx/snippets/pyquest-author-headers.conf;
    }
    location = /css/author.css {
        auth_request /_auth_check;
        error_page 401 = @author_login;
        include /etc/nginx/snippets/pyquest-author-headers.conf;
    }
    location ^~ /js/author/ {
        auth_request /_auth_check;
        error_page 401 = @author_login;
        include /etc/nginx/snippets/pyquest-author-headers.conf;
    }
    location ~ ^/js/i18n/author\.[a-z]+\.json$ {
        auth_request /_auth_check;
        error_page 401 = @author_login;
        include /etc/nginx/snippets/pyquest-author-headers.conf;
    }

    # ---- Backend Django ------------------------------------------------------------------------------------

    # Connexion : peu d'essais autorisés (Django bloque aussi après 5 échecs par compte pendant 15 minutes).
    location = /api/auth/login/ {
        limit_req zone=pyquest_login burst=5 nodelay;
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;   # écrase toute valeur envoyée par le client
    }

    # Le reste de l'API (synchronisation, déconnexion) ; /api/auth/check/ n'est joignable que par la sous-requête interne.
    location = /api/auth/check/ {
        return 404;
    }
    location /api/ {
        limit_req zone=pyquest_sync burst=20 nodelay;
        client_max_body_size 300k;
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
