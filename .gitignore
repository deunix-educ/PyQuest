# Assets Pyodide vendorisés — régénérés par `make vendor-pyodide`, trop volumineux pour git
vendor/

# Secrets et configuration locale — jamais commités
.env
.env.*
*.pem
*.key
secrets.*

# Backend Django
backend/**/__pycache__/
backend/**/*.pyc
backend/db.sqlite3
backend/**/*.mo
backend/staticfiles/
backend/.venv/
.venv-voice/
.cache/
backend/venv/

# Environnement virtuel Python de développement
.venv/

# Dépendances JS (si un outillage de build/test est ajouté plus tard)
node_modules/

# Build / artefacts
dist/
build/
*.log

# Éditeurs / OS
.vscode/*
!.vscode/extensions.json
.DS_Store
